{
  "outputDirectory": "public",
  "buildCommand": "cp CHANGELOG.md public/CHANGELOG.md",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/appcast.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/about",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</contact.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</privacy.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/changelog",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</CHANGELOG.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</blog.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/best-mac-dictation-apps",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</blog/best-mac-dictation-apps.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/offline-dictation-mac",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</blog/offline-dictation-mac.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/whisper-vs-scribe-vs-nova-3",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</blog/whisper-vs-scribe-vs-nova-3.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/dictating-code-and-prompts",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</blog/dictating-code-and-prompts.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare/wispr-flow",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare/wispr-flow.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare/superwhisper",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare/superwhisper.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare/macwhisper",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare/macwhisper.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare/apple-dictation",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare/apple-dictation.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/compare/granola",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "</compare/granola.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/(blog|compare).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(blog|compare)/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(index|about|contact|privacy|CHANGELOG).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/appcast", "destination": "/appcast.xml" }
  ]
}
